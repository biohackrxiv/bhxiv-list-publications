{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "dcterms": "http://purl.org/dc/terms/",
    "dcmitype": "http://purl.org/dc/dcmitype/",
    "schema": "https://schema.org/",
    "bhxiv": "https://biohackrxiv.org/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "title": "dcterms:title",
    "identifier": "dcterms:identifier",
    "isVersionOf": {
      "@id": "dcterms:isVersionOf",
      "@type": "@id"
    },
    "publisher": "dcterms:publisher",
    "type": {
      "@id": "dcterms:type",
      "@type": "@vocab"
    },
    "description": "dcterms:description",
    "dateAccepted": {
      "@id": "dcterms:dateAccepted",
      "@type": "xsd:dateTime"
    },
    "dateWithdrawn": {
      "@id": "bhxiv:dateWithdrawn",
      "@type": "xsd:dateTime"
    },
    "event": {
      "@id": "bhxiv:ledgerEvent",
      "@type": "@vocab"
    },
    "accepted": "bhxiv:Accepted",
    "withdrawn": "bhxiv:Withdrawn",
    "pdfSha256": "bhxiv:pdfSha256",
    "Text": "dcmitype:Text"
  }
}
